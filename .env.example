# Cloudflare Pages Functions / wrangler .dev.vars
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Find new scholarships. Search providers are tried in this order; with no keys the
# keyless DuckDuckGo fallback is used. The model key above reads each page.
FIRECRAWL_API_KEY=
BRAVE_API_KEY=
# Shared secret for the daily job (X-Cron-Secret header), 24+ random characters.
CRON_SECRET=
